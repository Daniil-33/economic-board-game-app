{
  "name": "economic-board-game-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "guard": "node scripts/validate-bootstrap.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test scripts/tests/*.test.mjs",
    "knowledge:status": "node scripts/knowledge-status.mjs",
    "knowledge:verify": "node scripts/knowledge-status.mjs --online",
    "spec:new": "node scripts/spec-scaffold.mjs",
    "check": "pnpm run guard && pnpm run knowledge:status && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
